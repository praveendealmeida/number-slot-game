# ---------------------------------------------------------------------------
# Database (PostgreSQL) — used by Prisma via the @prisma/adapter-pg adapter.
# The CLI (db push / migrate / seed) reads this through prisma.config.ts.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# ---------------------------------------------------------------------------
# Auth.js (NextAuth v5) — Admin credentials login.
# ---------------------------------------------------------------------------
# Generate a secret with:  npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-random-32-byte-secret"

# Admin credentials — used to log into the web admin panel at /admin/login
ADMIN_USERNAME="praveendealmeida95"
ADMIN_PASSWORD="Buzz1234"

# The email associated with the admin user (used to create/identify the user in DB)
ADMIN_EMAIL="admin@luckylanka.lk"

# ---------------------------------------------------------------------------
# Mobile app authentication — Phone OTP.
# ---------------------------------------------------------------------------
# Demo mode: new users get Rs 5,000 test balance. Set to "false" in production.
DEMO_MODE=true
# OTP mode:
#   sandbox → fixed test code (OTP_TEST_CODE), no real SMS sent.
#   notify  → generates a secure 6-digit OTP and sends it via Notify.lk.
OTP_MODE=sandbox
OTP_TEST_CODE=123456

# Notify.lk SMS delivery (used when OTP_MODE=notify).
# Get these from https://app.notify.lk/settings/api-keys
NOTIFY_LK_USER_ID="USER-ID"
NOTIFY_LK_API_KEY="API-KEY"
# Your approved Sender ID. Use "NotifyDEMO" for testing only — the docs warn
# against sending OTP content with the demo sender (risk of account suspension).
NOTIFY_LK_SENDER_ID="NotifyDEMO"

# ---------------------------------------------------------------------------
# Payments — demo sandbox (temporary; no real gateway wired in yet).
# ---------------------------------------------------------------------------
# Buying a ticket debits the user's in-app wallet directly (see src/services/
# wallet.ts) — no external payment gateway is involved. Wallets are funded
# via DEMO_MODE's Rs 5,000 top-up or manual admin credit (see the admin
# dashboard's user wallet adjustment). Swap in a real gateway before this
# app handles real money — see src/app/api/games/[gameId]/tickets/route.ts.

# ---------------------------------------------------------------------------
# Daily game rotation (auto-close/draw + tier refill) — see vercel.json.
# Required in production for Vercel Cron to authenticate its call to
# /api/cron/rotate-games. Generate a random 16+ char string.
# ---------------------------------------------------------------------------
CRON_SECRET="Itr1ECyoHqX5bSTGjiKncdN6DJYWlAgB"