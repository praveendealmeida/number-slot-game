# ---------------------------------------------------------------------------
# Database (PostgreSQL) — used by Prisma via the @prisma/adapter-pg adapter.
# The CLI (db push / migrate / seed) reads this through prisma.config.ts.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# ---------------------------------------------------------------------------
# Auth.js (NextAuth v5) — Admin credentials login.
# ---------------------------------------------------------------------------
# Generate a secret with:  npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-random-32-byte-secret"

# Admin credentials — used to log into the web admin panel at /admin/login
ADMIN_USERNAME="praveendealmeida95"
ADMIN_PASSWORD="Buzz1234"

# The email associated with the admin user (used to create/identify the user in DB)
ADMIN_EMAIL="admin@luckylanka.lk"

# ---------------------------------------------------------------------------
# Mobile app authentication — Phone OTP.
# ---------------------------------------------------------------------------
# Demo mode: new users get Rs 5,000 test balance. Set to "false" in production.
DEMO_MODE=true
# Sandbox mode: uses a fixed test code (OTP_TEST_CODE) for all phones.
# Set to "live" when integrating with a real SMS provider (Dialog/Mobitel/Airtel).
OTP_MODE=sandbox
OTP_TEST_CODE=123456

# ---------------------------------------------------------------------------
# Payments — Chain2Pay (https://docs.chain2pay.is). Hosted card-to-crypto.
# ---------------------------------------------------------------------------
# Use a sandbox key (c2p_sandbox_...) for testing, live key (c2p_live_...) in prod.
CHAIN2PAY_API_KEY="c2p_sandbox_xxx"
# Optional: set a webhook secret in the dashboard and paste it here to verify signatures.
CHAIN2PAY_WEBHOOK_SECRET=""
# Settlement currency (USD, EUR, GBP, or CAD). Gateway does NOT support LKR.
CHAIN2PAY_CURRENCY="USD"
# Fiat units per 1 LKR, used to convert ticket prices. ~0.0033 = USD.
CHAIN2PAY_FIAT_PER_LKR="0.0033"
# Per-payment minimum the providers enforce (multihosted default ~6 USD).
CHAIN2PAY_MIN_AMOUNT="6"
# How long (minutes) a slot stays reserved while the buyer pays.
CHAIN2PAY_RESERVATION_MINUTES="20"
# Public base URL used to build the webhook callback. On Vercel set to your domain.
APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Daily game rotation (auto-close/draw + tier refill) — see vercel.json.
# Required in production for Vercel Cron to authenticate its call to
# /api/cron/rotate-games. Generate a random 16+ char string.
# ---------------------------------------------------------------------------
CRON_SECRET="replace-with-a-random-16-plus-char-secret"